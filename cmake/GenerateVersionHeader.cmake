# cmake/GenerateVersionHeader.cmake
# Automatically extracts version metadata from git tags/commits and generates CasterVersion.h

if(NOT DEFINED SOURCE_DIR)
    set(SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
endif()

if(NOT DEFINED FALLBACK_VERSION)
    if(EXISTS "${SOURCE_DIR}/VERSION")
        file(READ "${SOURCE_DIR}/VERSION" FILE_VER)
        string(STRIP "${FILE_VER}" FALLBACK_VERSION)
    else()
        set(FALLBACK_VERSION "0.0.0")
    endif()
endif()

# 1. Determine RAW_DESC
set(RAW_DESC "")
if(DEFINED EXPLICIT_VERSION AND NOT EXPLICIT_VERSION STREQUAL "")
    set(RAW_DESC "${EXPLICIT_VERSION}")
elseif(EXISTS "${SOURCE_DIR}/VERSION")
    file(READ "${SOURCE_DIR}/VERSION" FILE_VER)
    string(STRIP "${FILE_VER}" FILE_VER)
    if(NOT FILE_VER STREQUAL "")
        set(RAW_DESC "${FILE_VER}")
    endif()
endif()

if(RAW_DESC STREQUAL "")
    find_package(Git QUIET)
    if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
        execute_process(
            COMMAND ${GIT_EXECUTABLE} describe --tags --always --dirty
            WORKING_DIRECTORY "${SOURCE_DIR}"
            OUTPUT_VARIABLE GIT_DESCRIBE_OUT
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        if(NOT GIT_DESCRIBE_OUT STREQUAL "")
            set(RAW_DESC "${GIT_DESCRIBE_OUT}")
        endif()
    endif()
endif()

if(RAW_DESC STREQUAL "")
    set(RAW_DESC "${FALLBACK_VERSION}")
endif()

# Strip leading 'v'
if(RAW_DESC MATCHES "^v(.+)")
    set(RAW_DESC "${CMAKE_MATCH_1}")
endif()

# Parse into clean SemVer
set(SEMVER_NUMERIC "${FALLBACK_VERSION}")
set(MAJOR "0")
set(MINOR "0")
set(PATCH "0")
if(FALLBACK_VERSION MATCHES "^([0-9]+)\\.([0-9]+)(\\.([0-9]+))?$")
    set(MAJOR "${CMAKE_MATCH_1}")
    set(MINOR "${CMAKE_MATCH_2}")
    if(CMAKE_MATCH_4)
        set(PATCH "${CMAKE_MATCH_4}")
    endif()
endif()
set(IS_DEV "false")
set(VERSION_STRING "${RAW_DESC}")

# Pattern A: Pure release tag (e.g. 2.0.0 or 2.1)
if(RAW_DESC MATCHES "^([0-9]+)\\.([0-9]+)(\\.([0-9]+))?$")
    set(MAJOR "${CMAKE_MATCH_1}")
    set(MINOR "${CMAKE_MATCH_2}")
    if(CMAKE_MATCH_4)
        set(PATCH "${CMAKE_MATCH_4}")
    else()
        set(PATCH "0")
    endif()
    set(SEMVER_NUMERIC "${MAJOR}.${MINOR}.${PATCH}")
    set(VERSION_STRING "${SEMVER_NUMERIC}")
    set(IS_DEV "false")

# Pattern B: Tag with commits ahead (e.g. 2.0.0-31-gace6590 or 2.0.0-31-gace6590-dirty)
elseif(RAW_DESC MATCHES "^([0-9]+)\\.([0-9]+)(\\.([0-9]+))?-([0-9]+)-g([0-9a-f]+)(-dirty)?$")
    set(MAJOR "${CMAKE_MATCH_1}")
    set(MINOR "${CMAKE_MATCH_2}")
    if(CMAKE_MATCH_4)
        set(PATCH "${CMAKE_MATCH_4}")
    else()
        set(PATCH "0")
    endif()
    set(SEMVER_NUMERIC "${MAJOR}.${MINOR}.${PATCH}")
    set(COUNT "${CMAKE_MATCH_5}")
    set(COMMIT "${CMAKE_MATCH_6}")
    set(DIRTY "${CMAKE_MATCH_7}")
    set(VERSION_STRING "${SEMVER_NUMERIC}-dev.${COUNT}+${COMMIT}")
    if(DIRTY)
        string(APPEND VERSION_STRING ".dirty")
    endif()
    set(IS_DEV "true")

# Pattern C: Commit hash only (e.g. ace6590 or ace6590-dirty)
elseif(RAW_DESC MATCHES "^([0-9a-f]+)(-dirty)?$")
    set(COMMIT "${CMAKE_MATCH_1}")
    set(DIRTY "${CMAKE_MATCH_2}")
    set(SEMVER_NUMERIC "0.0.0")
    set(MAJOR "0")
    set(MINOR "0")
    set(PATCH "0")
    set(VERSION_STRING "0.0.0-dev+${COMMIT}")
    if(DIRTY)
        string(APPEND VERSION_STRING ".dirty")
    endif()
    set(IS_DEV "true")

# Pattern D: Custom / RC strings (e.g. 2.1.0-rc1)
else()
    if(RAW_DESC MATCHES "^([0-9]+)\\.([0-9]+)(\\.([0-9]+))?")
        set(MAJOR "${CMAKE_MATCH_1}")
        set(MINOR "${CMAKE_MATCH_2}")
        if(CMAKE_MATCH_4)
            set(PATCH "${CMAKE_MATCH_4}")
        else()
            set(PATCH "0")
        endif()
        set(SEMVER_NUMERIC "${MAJOR}.${MINOR}.${PATCH}")
    endif()
    set(VERSION_STRING "${RAW_DESC}")
    if(RAW_DESC MATCHES "dev" OR RAW_DESC MATCHES "rc" OR RAW_DESC MATCHES "alpha" OR RAW_DESC MATCHES "beta" OR RAW_DESC MATCHES "-")
        set(IS_DEV "true")
    else()
        set(IS_DEV "false")
    endif()
endif()

# Write semver if requested
if(DEFINED SEMVER_OUTPUT AND NOT SEMVER_OUTPUT STREQUAL "")
    get_filename_component(SEMVER_DIR "${SEMVER_OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${SEMVER_DIR}")
    file(WRITE "${SEMVER_OUTPUT}.tmp" "${SEMVER_NUMERIC}\n")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${SEMVER_OUTPUT}.tmp" "${SEMVER_OUTPUT}")
    file(REMOVE "${SEMVER_OUTPUT}.tmp")
endif()

# Write CasterVersion.h if requested
if(DEFINED HEADER_OUTPUT AND NOT HEADER_OUTPUT STREQUAL "")
    get_filename_component(HEADER_DIR "${HEADER_OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${HEADER_DIR}")
    
    set(HEADER_CONTENT "// Auto-generated by CMake GenerateVersionHeader.cmake - DO NOT EDIT MANUALLY\n")
    string(APPEND HEADER_CONTENT "#ifndef CASTER_VERSION_H\n")
    string(APPEND HEADER_CONTENT "#define CASTER_VERSION_H\n\n")
    string(APPEND HEADER_CONTENT "#define CASTER_VERSION_STRING \"${VERSION_STRING}\"\n")
    string(APPEND HEADER_CONTENT "#define CASTER_VERSION_MAJOR ${MAJOR}\n")
    string(APPEND HEADER_CONTENT "#define CASTER_VERSION_MINOR ${MINOR}\n")
    string(APPEND HEADER_CONTENT "#define CASTER_VERSION_PATCH ${PATCH}\n")
    string(APPEND HEADER_CONTENT "#define CASTER_VERSION_IS_DEV ${IS_DEV}\n\n")
    string(APPEND HEADER_CONTENT "#endif // CASTER_VERSION_H\n")

    file(WRITE "${HEADER_OUTPUT}.tmp" "${HEADER_CONTENT}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${HEADER_OUTPUT}.tmp" "${HEADER_OUTPUT}")
    file(REMOVE "${HEADER_OUTPUT}.tmp")
endif()
