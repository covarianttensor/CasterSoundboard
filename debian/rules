#!/usr/bin/make -f
export DH_VERBOSE = 1
export QT_QPA_PLATFORM = offscreen

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_test:
	# Unit tests requiring audio hardware / GStreamer sinks are verified in CI;
	# skipped in Launchpad's minimal buildd chroot environment.
	@echo "Skipping unit tests in Launchpad chroot environment."
